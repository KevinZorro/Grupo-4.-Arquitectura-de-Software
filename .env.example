# Núcleo asistencial (apps/core). Copiar a `.env` en la raíz: cp .env.example .env
# NODE_ENV acepta development, test o production y no tiene valor por defecto.
# La cabecera X-Usuario-Dev y Swagger solo existen con NODE_ENV=development.
NODE_ENV=development
PORT=3000
CORE_DATABASE_URL=postgresql://core:core_password@localhost:5432/core_db
# Orígenes que pueden llamar a la API desde el navegador, separados por comas.
# Vacío desactiva CORS. Vite sirve el frontend en el 5173.
CORS_ORIGINS=http://localhost:5173

AUDIT_DATABASE_URL=postgresql://audit:audit_password@localhost:5433/audit_db
RABBITMQ_URL=amqp://app:app_password@localhost:5672
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
